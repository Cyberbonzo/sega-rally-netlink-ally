+static void quad(const Cmd& c, Pt a, Pt b, Pt cc, Pt d) {
+    raster_quad<false>(c, a, b, cc, d);
+    if (!g_rally_hd_target) return;
+    if ((c.ctrl & 15) <= 1) {
+        // Sprites specify inclusive opposite corners, including one-dot text.
+        const bool right = a.x <= b.x, down = a.y <= d.y;
+        if (right) { ++b.x; ++cc.x; } else { ++a.x; ++d.x; }
+        if (down) { ++d.y; ++cc.y; } else { ++a.y; ++b.y; }
+        a = hd_point(a); b = hd_point(b); cc = hd_point(cc); d = hd_point(d);
+        if (right) { --b.x; --cc.x; } else { --a.x; --d.x; }
+        if (down) { --d.y; --cc.y; } else { --a.y; --b.y; }
+    } else {
+        a = hd_point(a); b = hd_point(b); cc = hd_point(cc); d = hd_point(d);
+        if (g_full_hd && full_hd_surface(c, a, b, cc, d)) return;
+    }
+    raster_quad<true>(c, a, b, cc, d);
+}
