+// Scan-convert a strip of the bilinear command surface on the output grid.
+// Texel coordinates advance across contiguous physical pixels. The half-open
+// edges give adjacent triangles a shared edge without drawing it twice.
+static void surface_triangle(const Cmd& c, const RallyTexture* texture, const SurfaceClip& clip,
+                             SurfaceVertex a, SurfaceVertex b, SurfaceVertex d) {
+    if (b.y < a.y) std::swap(a, b);
+    if (d.y < a.y) std::swap(a, d);
+    if (d.y < b.y) std::swap(b, d);
+    const float bx = b.x - a.x, by = b.y - a.y, dx = d.x - a.x, dy = d.y - a.y;
+    const float det = bx * dy - dx * by;
+    if (std::abs(det) < 0.001f) return;
+    const int top = std::max(clip.y0, (int)std::ceil(a.y - 0.5f));
+    const int bottom = std::min(clip.y1, (int)std::ceil(d.y - 0.5f));
+    if (top >= bottom) return;
+    const float ux = ((b.u - a.u) * dy - (d.u - a.u) * by) / det;
+    const float vx = ((b.v - a.v) * dy - (d.v - a.v) * by) / det;
+    const float uy = (bx * (d.u - a.u) - dx * (b.u - a.u)) / det;
+    const float vy = (bx * (d.v - a.v) - dx * (b.v - a.v)) / det;
+    // A subpixel sliver can have a steep gradient and cover only one sample.
+    const int du = (int)std::clamp(ux * 4096.f, -67108864.f, 67108864.f);
+    const int dv = (int)std::clamp(vx * 4096.f, -67108864.f, 67108864.f);
+    const float outer_dx = dx / dy;
+    auto half = [&](int first, int last, const SurfaceVertex& p, const SurfaceVertex& q) {
+        if (first >= last) return;
+        const float inner_dx = (q.x - p.x) / (q.y - p.y);
+        for (int y = first; y < last; ++y) {
+            const float sy = y + 0.5f;
+            const float l = a.x + (sy - a.y) * outer_dx;
+            const float r = p.x + (sy - p.y) * inner_dx;
+            const int left = std::max(clip.x0, (int)std::ceil(std::min(l,r) - 0.5f));
+            const int right = std::min(clip.x1, (int)std::ceil(std::max(l,r) - 0.5f));
+            if (right <= left) continue;
+            uint16_t* dst = g_rally_hd_target + y * 1920 + left;
+            if (!texture) {
+                std::fill(dst, dst + (right - left), c.colr);
+                continue;
+            }
+            const float ox = left + 0.5f - a.x, oy = sy - a.y;
+            const int u = (int)(std::clamp(a.u + ox * ux + oy * uy, 0.f, (float)c.w) * 4096.f);
+            const int v = (int)(std::clamp(a.v + ox * vx + oy * vy, 0.f, (float)c.h) * 4096.f);
+            if (texture->opaque) surface_texels<true>(dst, right-left, texture->pixels.data(), c.w, c.h, u, v, du, dv);
+            else surface_texels<false>(dst, right-left, texture->pixels.data(), c.w, c.h, u, v, du, dv);
+        }
+    };
+    const int split = std::clamp((int)std::ceil(b.y - 0.5f), top, bottom);
+    half(top, split, a, b);
+    half(split, bottom, b, d);
+}
