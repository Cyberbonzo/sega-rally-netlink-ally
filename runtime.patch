+static const RallyTexture& rally_texture(const Cmd& c) {
+    const uint64_t key = (uint64_t)c.srca << 40 | (uint64_t)c.colr << 24 |
+                         (uint64_t)c.w << 8 | (unsigned)c.h;
+    auto [it, fresh] = g_rally_textures.try_emplace(key);
+    RallyTexture& texture = it->second;
+    if (fresh) {
+        texture.pixels.resize(c.w * c.h);
+        for (int i = 0; i < c.w * c.h; ++i) {
+            const unsigned pair = g_tex[(c.srca + i / 2) & 0x7FFFF];
+            const unsigned index = i & 1 ? pair & 15 : pair >> 4;
+            texture.pixels[i] = index ? c.lut[index] : 0;
+            if (!index) texture.opaque = false;
+            else if (!c.lut[index]) texture.zero_colour = true;
+        }
+    }
+    return texture;
+}
