+// RALLYPLUS_0 is the NetLink edition's cabinet progress. The game reuses the
+// original BIOS transfer buffer while driving. Encode directly from the same
+// committed records, car setups and options as its own save routine.
+using RallyProgress = std::array<uint8_t, 0x13C0>;
+static RallyProgress rally_progress_image() {
+    RallyProgress image{};
+    size_t out = 0;
+    auto copy = [&](size_t address, size_t count) {
+        std::copy_n(g_wram_h + address, count, image.begin() + out);
+        out += count;
+    };
+    auto word = [](const uint8_t* p) -> uint32_t {
+        return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+    };
+    for (size_t i = 0; i < 384; ++i) {
+        const uint8_t* record = g_wram_h + 0xC3220 + 8 * i;
+        uint32_t attributes = word(record + 4);
+        uint32_t time = word(record) + ((attributes & 0x70000000u) >> 7);
+        uint32_t colour = ((attributes & 0x01000000u) >> 9) + ((attributes & 0xFF0000u) >> 6)
+                        + ((attributes & 0xFF00u) >> 3) + (attributes & 0xFFu);
+        image[out++] = uint8_t(time >> 16);
+        image[out++] = uint8_t(time >> 8);
+        image[out++] = uint8_t(time);
+        image[out++] = uint8_t(colour >> 8);
+        image[out++] = uint8_t(colour);
+    }
+    copy(0xC3E20, 0xC08);
+    image[out++] = g_wram_h[0xC2062] & 0x16;
+    copy(0xC2063, 33);
+    copy(0xC4A38, 17);
+    image[out++] = uint8_t(g_wram_h[0xC4A4C] << 4 | (g_wram_h[0xC4A4D] & 15));
+    uint32_t checksum = 9;
+    for (size_t i = 0; i < out; i += 4) checksum += word(&image[i]);
+    for (int shift = 24; shift >= 0; shift -= 8) image[out++] = uint8_t(checksum >> shift);
+    return image;
+}
