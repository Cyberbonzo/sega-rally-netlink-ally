+static void line(const Cmd& c, Pt a, Pt b, int v, Rgb g0, Rgb g1) {
+    raster_line<false>(c, a, b, v, g0, g1);
+    if (g_rally_hd_target) raster_line<true>(c, hd_point(a), hd_point(b), v, g0, g1);
+}
