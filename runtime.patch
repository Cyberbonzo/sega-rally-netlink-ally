+        uint32_t raw = (uint32_t)vw(table + off) << 16 | vw(table + off + 2);
+        return signed_bits(raw & mask, bits);
+    };
+    auto point = [&](int off) -> int64_t { return signed_bits(vw(table + off), 14) * 65536ll; };
+    auto mul = [](int64_t a, int64_t b) { return a * b >> 16; };
+    int64_t start[3], pivot[3], center[3];
+    for (int k = 0; k < 3; ++k) {
+        start[k] = field(4 * k, 29, ~63u);
+        pivot[k] = point(0x34 + 2 * k);
+        center[k] = point(0x3C + 2 * k);
+    }
+    const int64_t dx = field(0x14, 19, ~63u), dy = field(0x18, 19, ~63u);
+    uint16_t reload = reg(0xB2) >> (8 * param);
+    const int64_t vx = reload & 1 ? 0 : field(0x0C, 19, ~63u);
+    const int64_t vy = reload & 2 ? 0 : field(0x10, 19, ~63u);
+    RotationMap m{};
+    for (int axis = 0; axis < 2; ++axis) {
+        int64_t matrix[3], src = 0, offset = center[axis] + field(0x44 + 4 * axis, 30, ~63u);
+        for (int k = 0; k < 3; ++k) {
+            matrix[k] = field(0x1C + 4 * (axis * 3 + k), 20, ~63u);
+            src += mul(matrix[k], start[k] - pivot[k]);
+            offset += mul(matrix[k], pivot[k] - center[k]);
+        }
+        int64_t scale = field(0x4C + 4 * axis, 24, ~0u);
+        m.origin[axis] = offset + mul(scale, src);
+        m.horizontal[axis] = mul(scale, mul(matrix[0], dx) + mul(matrix[1], dy));
+        m.vertical[axis] = mul(scale, mul(matrix[0], vx) + mul(matrix[1], vy));
+    }
