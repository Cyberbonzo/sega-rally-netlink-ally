+// Refresh short motor commands so losing focus or leaving the race cannot
+// leave a motor running. Only the gamepad assigned to the driver receives them.
+static void rally_rumble(int speed) {
+    static int last_speed;
+    static Uint64 next;
+    static bool reported;
+    if (speed <= 3 && !last_speed) return;
+    Uint64 now = SDL_GetTicks();
+    if (speed > 3 && now < next) return;
+    unsigned low = 0, high = 0;
+    if (speed > 3) {
+        int drop = last_speed - speed;
+        low = 3800 + 22 * std::min(speed, 220);
+        high = 1600 + 12 * std::min(speed, 220);
+        if (drop >= 8) {
+            low += 4200;
+            high += 3200;
+        }
+    }
+    last_speed = low ? speed : 0;
+    next = now + 80;
+    for (const auto& p : g_pads) {
+        if (g_slots.slot_of(p.id) != 0) continue;
+        bool ok = SDL_RumbleGamepad(p.pad, low, high, low ? 130 : 0);
+        if (!reported && low) {
+            sat_note("race rumble: player 1, %d km/h, motors %u/%u, %s",
+                     speed, low, high, ok ? "accepted" : SDL_GetError());
+            reported = true;
+        }
+    }
+}
