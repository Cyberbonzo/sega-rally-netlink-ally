+static void rally_progress_poll(bool exiting = false) {
+    if (!rally_loaded) return;
+    const uint64_t frame = sat_vblanks();
+    if (!exiting && frame < rally_next_sample) return;
+    rally_next_sample = frame + 15;
+    const auto image = rally_progress_image();
+    const bool stable = image == rally_observed;
