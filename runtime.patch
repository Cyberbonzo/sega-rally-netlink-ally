+static bool full_hd_surface(const Cmd& c, Pt a, Pt b, Pt cc, Pt d) {
+    const bool palette = c.textured && (c.pmod == 0x1488 || c.pmod == 0x1888);
+    const bool solid = !c.textured && !c.ccb && !c.mesh && !c.mon && !c.outside;
+    if (!palette && !solid) return false;
+    SurfaceClip clip{0, std::min(1920, hd_x(g_sys_x + 1)), 0, std::min(1080, hd_y(g_sys_y + 1))};
+    if (c.clip) {
+        clip.x0 = std::max(0, hd_x(g_ux0)); clip.y0 = std::max(0, hd_y(g_uy0));
+        clip.x1 = std::min(clip.x1, hd_x(g_ux1 + 1)); clip.y1 = std::min(clip.y1, hd_y(g_uy1 + 1));
+    }
+    if (std::max({a.x,b.x,cc.x,d.x}) < clip.x0 || std::min({a.x,b.x,cc.x,d.x}) >= clip.x1 ||
+        std::max({a.y,b.y,cc.y,d.y}) < clip.y0 || std::min({a.y,b.y,cc.y,d.y}) >= clip.y1) return true;
+    const RallyTexture* texture = palette ? &rally_texture(c) : nullptr;
+    if (texture && texture->zero_colour) return false;
+    // VDP1 paints the full source dot along independently rounded projected
+    // edges. A mathematical zero-width edge can expose sky between two tiles
+    // whose endpoints differ by a source dot. Keep half that footprint on
+    // course tiles while sampling their interior at full resolution.
+    if (palette && c.colr >= 0x15000 / 8 && c.srca >= 0x38000) {
+        const Pt corners[4]{a,b,cc,d};
+        Pt* expanded[4]{&a,&b,&cc,&d};
+        float area = 0;
+        for (int i = 0; i < 4; ++i) {
+            const Pt p = corners[i], q = corners[(i + 1) & 3];
+            area += (float)p.x * q.y - (float)p.y * q.x;
+        }
+        struct Normal { float x, y; } normals[4];
+        for (int i = 0; i < 4; ++i) {
+            const Pt p = corners[i], q = corners[(i + 1) & 3];
+            const float x = (float)(q.y - p.y), y = (float)(p.x - q.x);
+            const float inv = (area < 0 ? -1.f : 1.f) / std::max(1.f, std::sqrt(x*x + y*y));
+            normals[i] = {x*inv,y*inv};
+        }
+        for (int i = 0; i < 4; ++i) {
+            const auto prev = normals[(i + 3) & 3], next = normals[i];
+            const float scale = 2.5f / std::max(0.1f, 1.f + prev.x*next.x + prev.y*next.y);
+            expanded[i]->x += (int)std::round(std::clamp((prev.x + next.x)*scale, -5.f, 5.f));
+            expanded[i]->y += (int)std::round(std::clamp((prev.y + next.y)*scale, -5.f, 5.f));
+        }
+    }
+    const float u0 = c.hflip ? (float)c.w : 0.f, u1 = c.hflip ? 0.f : (float)c.w;
+    const float v0 = c.vflip ? (float)c.h : 0.f, v1 = c.vflip ? 0.f : (float)c.h;
+    // A trapezoid's texture has a bilinear cross-term. Subdivide it so one
+    // affine diagonal does not distort a road or the side of a vehicle.
+    int warp = std::max(std::abs(a.x + cc.x - b.x - d.x), std::abs(a.y + cc.y - b.y - d.y));
+    int strips = texture ? std::clamp(1 + warp / 16, 1, 32) : 1;
+    SurfaceVertex left{(float)a.x,(float)a.y,u0,v0}, right{(float)b.x,(float)b.y,u1,v0};
+    for (int i = 1; i <= strips; ++i) {
+        const float t = (float)i / strips, v = v0 + t * (v1 - v0);
+        SurfaceVertex next_l{a.x + (d.x-a.x)*t, a.y + (d.y-a.y)*t, u0, v};
+        SurfaceVertex next_r{b.x + (cc.x-b.x)*t, b.y + (cc.y-b.y)*t, u1, v};
+        surface_triangle(c, texture, clip, left, right, next_r);
+        surface_triangle(c, texture, clip, left, next_r, next_l);
+        left = next_l; right = next_r;
+    }
+    return true;
+}
