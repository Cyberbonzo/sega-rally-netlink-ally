+template<bool opaque>
+static inline void surface_texels(uint16_t* dst, int count, const uint16_t* texture,
+                                  int w, int h, int u, int v, int du, int dv) {
+    for (int i = 0; i < count; ++i) {
+        const int tx = std::clamp(u >> 12, 0, w - 1);
+        const int ty = std::clamp(v >> 12, 0, h - 1);
+        uint16_t colour = texture[ty * w + tx];
+        if (opaque || colour) dst[i] = colour;
+        u += du; v += dv;
+    }
+}
