+// Called by the disc-specific generated code around its initial BUP decode.
+// A restart must not overwrite an existing file with partially initialized RAM.
+void rally_progress_load_begin() { rally_loaded = false; }
+void rally_progress_load_end() {
+    rally_committed = rally_observed = rally_progress_image();
+    rally_next_sample = sat_vblanks() + 15;
+    rally_loaded = true;
