+void rally_garage_edited() {
+    if (!rally_loaded) return;
+    unsigned choice = g_wram_h[0xA88F2];     // 0 NEW CAR, 1..4 cars A..D
+    uint8_t& occupied = g_wram_h[0xC2063];
+    if (choice == 0) {
+        unsigned slots = 0;
+        while (slots < 4 && (occupied & (1u << slots))) ++slots;
+        if (slots == 4 || occupied != (1u << slots) - 1) return;
+        choice = slots + 1;
+        occupied = uint8_t((1u << choice) - 1);
+        g_wram_h[0xC202A] = uint8_t(choice);  // refresh the garage's count
+        g_wram_h[0xC202B] = 1;
+        g_wram_h[0xA88F2] = uint8_t(choice);
+        g_wram_h[0xA88F9] = uint8_t(slots);  // default target of manual SAVE
+    }
+    if (choice > 4 || !(occupied & (1u << (choice - 1)))) return;
+    uint8_t* setup = g_wram_h + 0xC2064 + (choice - 1) * 8;
+    setup[5] = g_wram_h[0xA88F3];          // transmission
+    std::copy_n(g_wram_h + 0xA88F4, 4, setup + 1);  // handling, tires, suspension
+    setup[7] = g_wram_h[0xA88F8];          // blow-off valve
+    setup[6] = g_wram_h[0xAA80A];          // vehicle
